<!doctype html>
<html lang="ko" data-theme="">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>지난 글 · {{ site.title | default("오늘의 경제 한 장") }}</title>
<style>{{ css }}</style>
</head>
<body>
<div class="wrap">
  <div class="top">
    <div>
      <h1 class="title">지난 글</h1>
      <div class="sub">{{ posts|length }}일치 기록</div>
    </div>
    <div class="navlinks">
      <a href="index.html">오늘</a>
      <a href="important.html">핵심 뉴스 모음</a>
      <button class="btn" id="themebtn" type="button">◐</button>
    </div>
  </div>
  <section>
    <ul class="arch">
      {%- for p in posts %}
      <li><a href="posts/{{ p.date }}.html">
        <span class="d">{{ p.date }} ({{ p.weekday }})</span>
        <span class="s">지수 {{ p.counts.indices_ok }}/{{ p.counts.indices_total }} · 뉴스 {{ p.counts.news }}건{% if p.top %} · 핵심 {{ p.top }}건{% endif %}</span>
      </a></li>
      {%- endfor %}
    </ul>
  </section>
</div>
<script>
(function(){
  var k='econ-theme', b=document.getElementById('themebtn');
  try{ var v=localStorage.getItem(k); if(v){ document.documentElement.dataset.theme=v; } }catch(e){}
  b && b.addEventListener('click', function(){
    var cur=document.documentElement.dataset.theme;
    var isDark = cur ? cur==='dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    document.documentElement.dataset.theme = isDark ? 'light' : 'dark';
    try{ localStorage.setItem(k, document.documentElement.dataset.theme); }catch(e){}
  });
})();
</script>
</body>
</html>
